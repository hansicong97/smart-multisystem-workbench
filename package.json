{
  "name": "smsw",
  "productName": "SMSW",
  "version": "0.3.0",
  "description": "Smart Multi-System Workbench desktop host prototype",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:main && vite build",
    "typecheck": "vue-tsc --noEmit",
    "prestart": "npm run build",
    "start": "electron .",
    "pretest": "npm run build:main",
    "test": "node --test tests/unit/*.test.js",
    "pretest:e2e": "npm run build",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/workbench.test.js tests/e2e/ui.test.js tests/e2e/reimbursement.test.js",
    "test:package": "node --test tests/e2e/packaged.test.js",
    "prepackage": "npm run build",
    "package": "electron-forge package",
    "premake": "npm run build",
    "make": "electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "45.4.1",
    "playwright-core": "1.65.1",
    "reka-ui": "2.11.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vue": "3.5.46",
    "vue-tsc": "3.3.14"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.8.26",
    "pdfjs-dist": "5.7.284",
    "zod": "4.6.7"
  }
}
